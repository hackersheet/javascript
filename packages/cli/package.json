{
  "name": "@hackersheet/cli",
  "version": "0.1.0-alpha.9",
  "description": "Hacker Sheet command line interface.",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/hackersheet/javascript.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "",
  "bin": {
    "hscli": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && pnpm tsup",
    "check": "pnpm tsc && pnpm lint",
    "format": "pnpm -w format && pnpm lint:fix",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,tsx}\"",
    "pub": "pnpm publish --access=public --tag alpha",
    "test": "vitest",
    "test:run": "vitest run",
    "watch": "tsup --watch"
  },
  "dependencies": {
    "@hackersheet/core": "workspace:*",
    "@inquirer/prompts": "^8.2.0",
    "@pnpm/tabtab": "^0.1.0",
    "commander": "^14.0.3",
    "find-up": "^8.0.0",
    "gray-matter": "^4.0.3",
    "mustache": "^4.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6"
  }
}
