{
  "name": "@hackersheet/javascript",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build -F @hackersheet/* -F !@hackersheet/sandbox*",
    "cli": "pnpm -F cli",
    "codegen": "gql-gen --config codegen.ts",
    "core": "pnpm -F core",
    "dev": "pnpm sandbox:next dev -p 3001",
    "format": "prettier --write --ignore-unknown .",
    "format:package": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' pnpm dlx sort-package-json \"package.json\" \"packages/*/package.json\" \"sandbox/*/package.json\"",
    "lint": "eslint",
    "ncu:minor": "pnpm ncu --deep -t minor",
    "next-document-content-components": "pnpm -F next-document-content-components",
    "next-document-content-kifu": "pnpm -F next-document-content-kifu",
    "react-document-content": "pnpm -F react-document-content",
    "react-document-content-styles": "pnpm -F react-document-content-styles",
    "sandbox:next": "pnpm -F @hackersheet/sandbox-next",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "turbo watch build -F @hackersheet/*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/client-preset": "5.0.2",
    "@next/eslint-plugin-next": "15.5.4",
    "@types/node": "24.6.2",
    "dotenv": "17.2.3",
    "dotenv-cli": "10.0.0",
    "eslint": "9.37.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.2.0",
    "graphql-config": "5.1.5",
    "npm-check-updates": "19.0.0",
    "prettier": "3.6.2",
    "terser": "5.44.0",
    "tsup": "8.5.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0"
  },
  "packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa",
  "engines": {
    "npm": "please_use_pnpm_instead"
  }
}
